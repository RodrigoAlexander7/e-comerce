# ----- Base de datos -----
DATABASE_URL="postgresql://atlas:atlas@localhost:5433/atlas_sport?schema=public"

# ----- Servidor -----
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ----- Impuestos (Peru) -----
# IGV en puntos basicos: 1800 = 18.00 %
TAX_RATE_BPS=1800
CURRENCY=PEN

# ----- Datos de la empresa (valores iniciales unicamente) -----
# Estos datos ya NO se leen en cada peticion: solo siembran la fila de
# configuracion de la tienda (tabla store_settings) la primera vez que se lee.
# A partir de ahi se editan desde el panel /admin/ajustes, incluido el QR de
# Yape, que se sube como imagen en lugar de apuntar a un archivo estatico.
COMPANY_NAME="Atlas Sport SAC"
COMPANY_RUC="20601758815"
COMPANY_EMAIL="ventas@atlassport.pe"
COMPANY_WHATSAPP="51946146622"
COMPANY_YAPE_PHONE="946 146 622"

# Cuentas bancarias mostradas en el correo de pago pendiente.
# Formato: Banco|Numero de cuenta|CCI  (separadas por ";")
COMPANY_BANK_ACCOUNTS="BBVA|0011-0286-0200122689|011-286-000200122689-29;Interbank|2003007729349|003-200-003007729349-33"

# Plazo para acreditar el pago offline antes de cancelar la orden.
# Tambien es solo el valor inicial: se edita despues desde el panel.
PAYMENT_WINDOW_HOURS=2

# ----- Correo saliente (SMTP) -----
# En desarrollo apunta a Mailpit (docker compose). Bandeja: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Atlas Sport <no-reply@atlassport.pe>"

# ----- Autenticacion -----
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-en-produccion"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
# Marca la cookie de sesion como Secure. En produccion (HTTPS) debe ser true;
# el valor por defecto ya sigue a NODE_ENV, esta variable es para forzarlo.
COOKIE_SECURE=false
# Dominio de la cookie de sesion. Vacio en desarrollo (localhost); en
# produccion, algo como ".atlassport.pe" si la API y la tienda comparten dominio.
COOKIE_DOMAIN=

# Correo de Google que recibe el rol SUPERADMIN al ejecutar "pnpm db:seed".
# Es la unica forma de obtener el primer acceso al panel: inicia sesion con
# Google usando este correo despues de sembrar la base de datos.
SUPERADMIN_EMAIL="tu-correo@gmail.com"

# ----- Almacenamiento de imagenes -----
UPLOADS_DIR="./uploads"
PUBLIC_ASSET_BASE_URL="http://localhost:3001/static"
